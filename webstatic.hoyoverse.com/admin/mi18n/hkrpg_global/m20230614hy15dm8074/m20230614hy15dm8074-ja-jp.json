    "page_title": "『崩壊：スターレイル』Ver.1.2特設ページ",
    "pic_share": "./fastcdn.hoyoverse.com/mi18n/hkrpg_global/m20230614hy15dm8074/upload/d6282b1ef5e8651973de715f12c61625_8843124680657935810.jpg",
